{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build SkyBooker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SkyBooker.sln",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test SkyBooker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/SkyBooker.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}

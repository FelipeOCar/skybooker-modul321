  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Registrierung\") {",
          "  const run = Date.now().toString(36) + Math.random().toString(36).slice(2, 5);",
          "  pm.collectionVariables.set(\"username\", \"felipe_\" + run);",
          "  pm.collectionVariables.set(\"email\", \"felipe_\" + run + \"@example.com\");",
          "  pm.collectionVariables.set(\"flightNo\", \"SK\" + run.slice(-10).toUpperCase());",
          "  pm.collectionVariables.set(\"departure\", new Date(Date.now() + 7 * 86400000).toISOString());",
          "  pm.collectionVariables.set(\"arrival\", new Date(Date.now() + 7 * 86400000 + 7200000).toISOString());",
          "  [\"token\", \"passengerId\", \"flightDbId\", \"bookingId\"].forEach(k => pm.collectionVariables.set(k, \"\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Registrierung",
      "request": {
        "method": "POST",
        "url": "{{authUrl}}/api/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"eMail\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
